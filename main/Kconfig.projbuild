menu "*** FireLamp configuration ***"

	config FL_EFFECT_DEFAULT
		int "Default effect"
		default 1
		
	config FL_FPS_DEFAULT
		int "Default FPS"
		range 1 100
		default 60

	config FL_BRIGHTNESS_DEFAULT
		int "Default brightness"
		range 1 255
		default 255

	config FL_EFFECTS_BENCHMARK
		bool "Benchmark all effects at boot"
		default n
		help
			Before normal operation, run every effect for a number of frames
			and log the computation and output time per frame. Use it to
			check the CPU headroom on a particular chip (ESP32-C3 has no FPU
			and a single core).

	menu "Default WiFi configuration"
		
		choice WIFI_MODE_C
			prompt "Default WiFi mode"
			default FL_WIFI_MODE_AP

			config FL_WIFI_MODE_AP
				bool "Access point"

			config FL_WIFI_MODE_STA
				bool "Station"

		endchoice

		menu "Access point mode"
		
			config FL_WIFI_AP_SSID
				string "SSID"
				default "FireLamp"
				
			config FL_WIFI_AP_PASSWD
				string "Password"
				default ""
	
			config FL_WIFI_AP_CHANNEL
				int "Channel"
				range 0 13
				default 6

		endmenu

		menu "Station mode"
		
			config FL_WIFI_STA_SSID
				string "SSID"
				default "MyHomeWIFI"
				
			config FL_WIFI_STA_PASSWD
				string "Password"
				default "MyPassword"
	
		endmenu

		config FL_WIFI_DHCP
			bool "Enable DHCP"
			default y
			
		config FL_WIFI_IP
			string "IP address"
			default "192.168.1.1"

		config FL_WIFI_NETMASK
			string "Netmask"
			default "255.255.255.0"

		config FL_WIFI_GATEWAY
			string "Gateway"
			default "192.168.1.1"
			
		config FL_WIFI_DNS
			string "DNS server"
			default "192.168.1.1"
			
	endmenu
	
	menu "Hardware configuration"

		menu "LED matrix"

			config FL_MATRIX_WIDTH
				int "Matrix width, pixels"
				range 8 128
				default 16

			config FL_MATRIX_HEIGHT
				int "Matrix height, pixels"
				range 8 128
				default 16

			config FL_MATRIX_GPIO
				int "Matrix data GPIO"
				range 0 39 if IDF_TARGET_ESP32
				range 0 21 if IDF_TARGET_ESP32C3
				default 5

			choice FL_LED_BACKEND_C
				prompt "LED output peripheral"
				default FL_LED_BACKEND_SPI if IDF_TARGET_ESP32C3
				default FL_LED_BACKEND_RMT
				help
					SPI with DMA streams the whole frame without CPU help and is
					robust against interrupt latency (BLE/WiFi). It is the only
					reliable option on ESP32-C3, whose RMT has no DMA and tiny
					channel memory. RMT is fine on ESP32.

				config FL_LED_BACKEND_SPI
					bool "SPI (with DMA)"

				config FL_LED_BACKEND_RMT
					bool "RMT"
			endchoice

			choice FL_LED_TYPE_C
				prompt "Default LED type"
				default FL_LED_TYPE_WS2812

				config FL_LED_TYPE_WS2812
					bool "WS2812"

				config FL_LED_TYPE_SK6812
					bool "SK6812"

				config FL_LED_TYPE_WS2811
					bool "WS2811 (also APA106, SM16703)"
			endchoice

			choice FL_LED_COLOR_ORDER_C
				prompt "Default color order"
				default FL_LED_COLOR_ORDER_GRB

				config FL_LED_COLOR_ORDER_GRB
					bool "GRB (WS2812, SK6812)"

				config FL_LED_COLOR_ORDER_RGB
					bool "RGB (APA106, many WS2811)"
			endchoice

			config FL_SINGLE_LED_CURRENT_MA
				int "Maximal current consuming by single pixel, mA (see in datasheet)"
				default 33

			config FL_MATRIX_MAX_CURRENT
				int "Restrict maximal current consuming by all LEDs, mA"
				default 5000

			choice FL_MATRIX_ROTATION_C
				prompt "Default surface rotation"
				default FL_MATRIX_ROTATION_0

				config FL_MATRIX_ROTATION_0
					bool "No rotation"

				config FL_MATRIX_ROTATION_90
					bool "90 degrees"

				config FL_MATRIX_ROTATION_180
					bool "180 degrees"

				config FL_MATRIX_ROTATION_270
					bool "270 degrees"
			endchoice

			config FL_MATRIX_MIRROR
				bool "Mirror surface horizontally by default"
				default n

		endmenu

		menu "Buttons configuration"

			config FL_BUTTON_LEVEL
				int "Button logic level for 'pressed' state"
				range 0 1
				default 1

			config FL_BUTTON_RESET_LEVEL
				int "Logic level of reset button for 'pressed' state"
				range 0 1
				default 0

			config FL_BUTTON_PULLUPDOWN
				bool "Enable internal pullup/pulldown resistor"
				default y

			config FL_BUTTON_MAIN_GPIO
				int "'Main' button GPIO pin"
				range 0 39 if IDF_TARGET_ESP32
				range 0 21 if IDF_TARGET_ESP32C3
				default 4 if IDF_TARGET_ESP32C3
				default 25

			config FL_BUTTON_UP_GPIO
				int "'Up' button GPIO pin"
				range 0 39 if IDF_TARGET_ESP32
				range 0 21 if IDF_TARGET_ESP32C3
				default 6 if IDF_TARGET_ESP32C3
				default 26

			config FL_BUTTON_DOWN_GPIO
				int "'Down' button GPIO pin"
				range 0 39 if IDF_TARGET_ESP32
				range 0 21 if IDF_TARGET_ESP32C3
				default 7 if IDF_TARGET_ESP32C3
				default 27

			config FL_BUTTON_RESET_GPIO
				int "'Reset' button GPIO pin"
				range 0 39 if IDF_TARGET_ESP32
				range 0 21 if IDF_TARGET_ESP32C3
				default 9 if IDF_TARGET_ESP32C3
				default 0

		endmenu

	endmenu

endmenu
