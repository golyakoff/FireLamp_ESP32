# Common defaults for all targets

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# BLE: NimBLE peripheral, one connection, bonding stored in NVS
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=5
# A bonded phone keeps up to 8 CCCD records (7 notifying characteristics + Service Changed).
# With the default 8, a second phone overflowed the CCCD store and NimBLE unpaired the first
# phone, so only one bond survived. 5 phones * 8 = 40, plus a margin for new notifications.
CONFIG_BT_NIMBLE_MAX_CCCDS=48
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# The brownout detector is turned on by the firmware (power_start()) once the LEDs are dark
CONFIG_ESP_BROWNOUT_DET=n
